{
  "ConnectionStrings": {
    "MurimiOSWorker": "Host=localhost;Port=55432;Database=murimios;Username=murimios_app;Password=murimios-app-dev"
  },
  "TenantDatabases": {
    "ControlDatabaseKey": "primary",
    "RouteCacheSeconds": 15,
    "Connections": {
      "primary": "MurimiOSWorker"
    }
  },
  "Messaging": {
    "Publisher": "RabbitMq"
  },
  "Outbox": {
    "BatchSize": 50,
    "LockSeconds": 60,
    "MaximumAttempts": 10,
    "InitialRetrySeconds": 5,
    "MaximumRetrySeconds": 3600,
    "PollMilliseconds": 1000
  },
  "Webhooks": {
    "BatchSize": 25,
    "LockSeconds": 60,
    "PollMilliseconds": 1000,
    "InitialRetrySeconds": 10,
    "MaximumRetrySeconds": 3600,
    "RequestTimeoutSeconds": 15
  },
  "ProviderIngestion": {
    "Enabled": true,
    "ScheduleBatchSize": 100,
    "MaximumAttempts": 8,
    "LockSeconds": 300,
    "PollMilliseconds": 5000
  },
  "TenantMigrationExecution": {
    "Enabled": true,
    "ArtifactRoot": "App_Data/tenant-migrations",
    "PollMilliseconds": 5000,
    "LeaseSeconds": 7200,
    "MaximumAttempts": 5,
    "MaximumRecordBytes": 16777216,
    "WriteDrainSeconds": 5
  },
  "AnalyticsMaintenance": {
    "Enabled": true,
    "ScheduleBatchSize": 100,
    "LockSeconds": 900,
    "MaximumAttempts": 5,
    "PollMilliseconds": 5000,
    "WarehouseRefreshMinutes": 15,
    "RetentionBatchSize": 5
  },
  "ConnectedDataLifecycle": {
    "Enabled": true,
    "PartitionYearsAhead": 3,
    "PartitionCheckMinutes": 360,
    "DeletionBatchSize": 25,
    "DeletionLockSeconds": 300,
    "MaximumDeletionAttempts": 8,
    "PollMilliseconds": 5000
  },
  "Storage": {
    "Provider": "Local",
    "MediaRoot": "../API/App_Data/media",
    "DataProtectionKeyRoot": "../API/App_Data/keys"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5673,
    "UserName": "murimios",
    "Password": "murimios-dev",
    "VirtualHost": "/",
    "Exchange": "murimios.events",
    "AppId": "murimios-worker"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
