{
  "ConnectionStrings": {
    "MurimiOS": "Host=localhost;Port=55432;Database=murimios;Username=murimios_app;Password=murimios-app-dev"
  },
  "TenantDatabases": {
    "ControlDatabaseKey": "primary",
    "RouteCacheSeconds": 15,
    "Connections": {
      "primary": "MurimiOS"
    }
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "Features": {
    "LegacyEndpointsEnabled": false
  },
  "Authentication": {
    "Authority": "",
    "Audience": "murimios-api",
    "RequireHttpsMetadata": true,
    "AllowDevelopmentTenantHeader": false,
    "Security": {
      "RequireMfaForWrites": true,
      "MfaClaimType": "amr",
      "MfaAcceptedValues": [ "mfa", "otp", "hwk" ],
      "AllowDevelopmentBypass": false,
      "SessionTouchMinutes": 5
    }
  },
  "RequestQuotas": {
    "Enabled": true,
    "TenantRequestLimit": 600,
    "TenantWindowSeconds": 60,
    "TenantDailyQuota": 100000,
    "ClientRequestLimit": 120,
    "ClientWindowSeconds": 60,
    "ClientDailyQuota": 20000
  },
  "ComplianceAuditPacks": {
    "SigningKeyBase64": "",
    "SigningKeyId": "",
    "MaximumArtifactBytes": 268435456,
    "VerificationKeys": {}
  },
  "Storage": {
    "Provider": "S3",
    "MediaRoot": "App_Data/media",
    "DataProtectionKeyRoot": "App_Data/keys",
    "S3": {
      "Endpoint": "localhost:59300",
      "AccessKey": "",
      "SecretKey": "",
      "Bucket": "murimios-media",
      "UseTls": false,
      "AutoCreateBucket": false,
      "StagingRoot": "App_Data/media-staging"
    }
  },
  "MediaScanning": {
    "Provider": "ClamAv",
    "ClamAv": {
      "Host": "localhost",
      "Port": 3310,
      "TimeoutSeconds": 30
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5673,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/",
    "Exchange": "murimios.events",
    "AppId": "murimios-api-health"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
